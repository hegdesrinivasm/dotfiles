{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "command": {
    "explain": {
      "template": "Go through the entire codebase and explain the tech stack, architecture, and what it does.",
      "description": "Explain the codebase and its tech."
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder (7b)"
        },
        "gemma4:latest": {
          "name": "Gemma 4"
        }
      }
    }
  },
  "default_agent": "plan",
  "autoupdate": "notify",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}