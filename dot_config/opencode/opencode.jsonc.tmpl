{
  "$schema": "https://opencode.ai/config.json",
  "username": "Srinivas Hegde M",
  "shell": {{ if eq .chezmoi.os "windows" }}"nu"{{ else }}"/bin/zsh"{{ end }},
  "command": {
    "explore": {
      "template": "Explore the codebase and understand the structure, architecture, and functionalities of the code.",
      "description": "Explore the codebase for code architecture and functionality."
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder (7b)"
        },
        "gemma4:latest": {
          "name": "Gemma 4"
        }
      }
    }
  },
  "default_agent": "plan",
  "autoupdate": "notify",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}