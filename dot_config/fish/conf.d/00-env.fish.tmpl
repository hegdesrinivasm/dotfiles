# Fish environment — autoloaded via conf.d on every fish startup.
# PATH entries are single-sourced in .chezmoidata.yaml (shellPath).
# See also: shell/env.sh.tmpl (bash/zsh), nushell/env.nu (hand-maintained).

{{ range .shellPath.entries -}}
{{- $whenOs := index . "when_os" -}}
{{- if or (not $whenOs) (eq $whenOs $.chezmoi.os) }}
# {{ .comment }}
{{- $dir := .direction }}
{{- range .paths }}
{{- if eq $dir "prepend" }}
fish_add_path --path --prepend "{{ . }}"
{{- else }}
fish_add_path --path --append "{{ . }}"
{{- end -}}
{{- end -}}
{{- end -}}
{{ end }}

# starship
if command -q starship
    starship init fish | source
end

# zoxide
if command -q zoxide
    zoxide init fish | source
end

# fzf
if command -q fzf
    fzf --fish | source
end
