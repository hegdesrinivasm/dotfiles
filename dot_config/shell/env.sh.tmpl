# Shared shell bootstrap — sourced by ~/.profile, ~/.bashrc, and ~/.zshrc.
# PATH entries are single-sourced in .chezmoidata.yaml (shellPath).
# See also: fish/conf.d/00-env.fish.tmpl, nushell/env.nu (hand-maintained).

export PYENV_ROOT="$HOME/.pyenv"
{{ range .shellPath.entries -}}
{{- $whenOs := index . "when_os" -}}
{{- if or (not $whenOs) (eq $whenOs $.chezmoi.os) }}
# {{ .comment }}
{{- $dir := .direction }}
{{- if eq .style "joined" }}
export PATH="{{ join ":" .paths }}{{ if eq $dir "prepend" }}:$PATH{{ else }}$PATH:{{ end }}"
{{- else -}}
{{- range .paths }}
if [ -d "{{ . }}" ]; then
{{- if eq $dir "prepend" }}
  PATH="{{ . }}:$PATH"
{{- else }}
  PATH="$PATH:{{ . }}"
{{- end }}
fi
{{- end -}}
{{- end -}}
{{- end -}}
{{ end }}

export PATH

# Prompt
if [ -n "$ZSH_VERSION" ]; then
  PROMPT='%~%# '
elif [ -n "$BASH_VERSION" ]; then
  PS1='\w\$ '
fi

# Starship
if command -v starship >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(starship init zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(starship init bash)"
  fi
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(zoxide init zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(zoxide init bash)"
  fi
fi

# fzf
if command -v fzf >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(fzf --zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(fzf --bash)"
  fi
fi
