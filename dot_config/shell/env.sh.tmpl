# Shared shell bootstrap — sourced by ~/.profile, ~/.bashrc, and ~/.zshrc
# so bash, zsh, and sh all get the same environment on any distro.
#
# PATH entries are single-sourced in .chezmoidata.yaml (shellPath) and shared
# with fish. nushell/env.nu mirrors them by hand (runtime OS check by design).
#
# Canonical order:
#   1. Homebrew (macOS only)
#   2. pyenv: ~/.pyenv/bin, ~/.pyenv/shims
#   3. opencode: ~/.opencode/bin
#   4. local: ~/.local/bin

export PYENV_ROOT="$HOME/.pyenv"
{{ range .shellPath.entries }}{{ $whenOs := index . "when_os" }}{{ if or (not $whenOs) (eq $whenOs $.chezmoi.os) }}

# {{ .comment }}
{{- $dir := .direction }}{{ if eq .style "joined" }}
export PATH="{{ join ":" .paths }}{{ if eq $dir "prepend" }}:$PATH{{ else }}$PATH:{{ end }}"
{{- else }}{{ range .paths }}
if [ -d "{{ . }}" ]; then
{{- if eq $dir "prepend" }}
  PATH="{{ . }}:$PATH"
{{- else }}
  PATH="$PATH:{{ . }}"
{{- end }}
fi
{{- end }}{{ end }}
{{- end }}{{ end }}

export PATH

# Prompt — per-shell because zsh and bash use different escape syntax
if [ -n "$ZSH_VERSION" ]; then
  PROMPT='%~%# '
elif [ -n "$BASH_VERSION" ]; then
  PS1='\w\$ '
fi

# Starship
if command -v starship >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(starship init zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(starship init bash)"
  fi
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(zoxide init zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(zoxide init bash)"
  fi
fi

# fzf
if command -v fzf >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(fzf --zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(fzf --bash)"
  fi
fi

