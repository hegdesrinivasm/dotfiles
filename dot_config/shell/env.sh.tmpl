# Shared shell bootstrap — sourced by ~/.profile, ~/.bashrc, and ~/.zshrc
# so bash, zsh, and sh all get the same environment on any distro.
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew (macOS only) — prepended for priority
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
{{- end }}

# pyenv — Python version manager
export PYENV_ROOT="$HOME/.pyenv"
if [ -d "$PYENV_ROOT/bin" ]; then
  PATH="$PYENV_ROOT/bin:$PATH"
fi
if [ -d "$PYENV_ROOT/shims" ]; then
  PATH="$PYENV_ROOT/shims:$PATH"
fi

# opencode
if [ -d "$HOME/.opencode/bin" ]; then
  PATH="$PATH:$HOME/.opencode/bin"
fi

# chezmoi / local bin
if [ -d "$HOME/.local/bin" ]; then
  PATH="$PATH:$HOME/.local/bin"
fi

export PATH

# Prompt — per-shell because zsh and bash use different escape syntax
if [ -n "$ZSH_VERSION" ]; then
  PROMPT='%~%# '
elif [ -n "$BASH_VERSION" ]; then
  PS1='\w\$ '
fi

# Starship
if command -v starship >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(starship init zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(starship init bash)"
  fi

  # nushell needs init.nu to exist before it parses env.nu; regenerate if stale
  if [ ! -s "$HOME/.cache/starship/init.nu" ]; then
    mkdir -p "$HOME/.cache/starship"
    starship init nu > "$HOME/.cache/starship/init.nu"
  fi
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(zoxide init zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(zoxide init bash)"
  fi
fi

# fzf
if command -v fzf >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(fzf --zsh)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(fzf --bash)"
  fi
fi

