{{ if and (eq .chezmoi.os "darwin") (not (stat (joinPath .chezmoi.homeDir ".install-apps.done"))) -}}
#!/bin/zsh

if command -v fish >/dev/null 2>&1 || command -v nu >/dev/null 2>&1; then
    touch "$HOME/.install-apps.done"
    exit 0
fi

# macOS Setup Script
# Installs Homebrew, CLI Tools, and specific applications.

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}Starting macOS setup script...${NC}"

# -----------------------------------------------------------------------------
# 1. Install Command Line Tools & Homebrew
# -----------------------------------------------------------------------------

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo -e "${BLUE}Homebrew not found. Installing Homebrew...${NC}"
    # This command also triggers the installation of Xcode Command Line Tools if missing
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Add Homebrew to PATH for the current session
    if [[ -f /opt/homebrew/bin/brew ]]; then
        echo -e "${BLUE}Configuring Homebrew for Apple Silicon...${NC}"
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then
        echo -e "${BLUE}Configuring Homebrew for Intel Mac...${NC}"
        eval "$(/usr/local/bin/brew shellenv)"
    fi
else
    echo -e "${GREEN}Homebrew is already installed.${NC}"
fi

# Make sure we are using the latest Homebrew
echo -e "${BLUE}Updating Homebrew...${NC}"
brew update

# -----------------------------------------------------------------------------
# 2. Install Command Line Utilities (Formulae)
# -----------------------------------------------------------------------------

echo -e "${BLUE}Installing Command Line Utilities...${NC}"

# List of formulae to install
formulae=(
    python
    git
    java
    pyenv
    pyenv-virtualenv
    openjdk
    nushell
    neovim
    fish
    node
    ollama
    go
    lua
)

failed=0

for formula in "${formulae[@]}"; do
    if brew list --formula | grep -q "^${formula}$"; then
        echo -e "${GREEN}$formula is already installed.${NC}"
    else
        echo -e "${BLUE}Installing $formula...${NC}"
        if ! brew install "$formula"; then
            echo -e "${RED}Failed to install $formula.${NC}"
            (( failed++ ))
        fi
    fi
done

# -----------------------------------------------------------------------------
# 3. Install GUI Applications (Casks)
# -----------------------------------------------------------------------------

echo -e "${BLUE}Installing GUI Applications (Casks)...${NC}"

# List of casks to install
casks=(
    visual-studio-code
    notion
    discord
    signal
    caffeine
    raycast
    vlc
    ticktick
    ente-auth
    zotero
    cleanupbuddy
    tailscale-app
    affinity
    steam
    shottr
    zen
)

for cask in "${casks[@]}"; do
    if brew list --cask | grep -q "^${cask}$"; then
        echo -e "${GREEN}$cask is already installed.${NC}"
    else
        echo -e "${BLUE}Installing $cask...${NC}"
        if ! brew install --cask "$cask"; then
            echo -e "${RED}Failed to install $cask.${NC}"
            (( failed++ ))
        fi
    fi
done

# -----------------------------------------------------------------------------
# 4. Set Fish as the default shell
# -----------------------------------------------------------------------------

FISH_BIN="$(brew --prefix)/bin/fish"

if [[ "$(dscl . -read "$HOME" UserShell 2>/dev/null | awk '{print $2}')" == "$FISH_BIN" ]]; then
    echo -e "${GREEN}Fish is already the default shell.${NC}"
else
    if ! grep -qx "$FISH_BIN" /etc/shells 2>/dev/null; then
        echo -e "${BLUE}Adding $FISH_BIN to /etc/shells...${NC}"
        echo "$FISH_BIN" | sudo tee -a /etc/shells
    fi

    echo -e "${BLUE}Setting Fish as the default shell...${NC}"
    sudo chsh -s "$FISH_BIN" "$USER" || { echo -e "${RED}Failed to set Fish as the default shell.${NC}"; exit 1; }
    echo -e "${GREEN}Fish set as the default shell. Log out and back in to use it.${NC}"
fi

# -----------------------------------------------------------------------------
# 5. Cleanup
# -----------------------------------------------------------------------------

echo -e "${BLUE}Cleaning up...${NC}"
brew cleanup

if (( failed > 0 )); then
    echo -e "${RED}$failed item(s) failed to install. Check the output above for details.${NC}"
    exit 1
else
    touch "$HOME/.install-apps.done"
    echo -e "${GREEN}Setup complete! You may need to restart your terminal or computer.${NC}"
    exit 0
fi
{{- end }}
