{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
# Install opencode (user-CLI tool). Windows installs it via winget instead
# (SST.opencode in run_once_after_install-apps.ps1.tmpl).
if [ -x "$HOME/.opencode/bin/opencode" ]; then
    exit 0
fi
# --no-modify-path: the installer's `echo -e` misbehaves under macOS /bin/sh
# (bash POSIX mode) and corrupts shell rc files; PATH is owned by conf.d instead.
curl -fsSL https://opencode.ai/install | sh -s -- --no-modify-path
{{ end -}}
